APP_ENV=development
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
WRANGLER_LOG_PATH=.wrangler
WRANGLER_LOG=debug

# Local E2E browser selection. Keep these overrides in .env, not this file.
# PLAYWRIGHT_BROWSER=webkit
# PLAYWRIGHT_BROWSER_PATH=/absolute/path/to/browser

# worktree 初始化會自動產生以下設定；未初始化時使用括號內的預設值。
# FEWFC_DEV_PORT=8787
# FEWFC_DEV_INSPECTOR_PORT=9229
# FEWFC_E2E_PORT=8727
# FEWFC_E2E_INSPECTOR_PORT=9230
# FEWFC_COMPONENT_PORT=8730
