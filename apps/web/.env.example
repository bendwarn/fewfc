APP_ENV=development
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
LOCAL_PASSWORD_RESET_ENABLED=false
WRANGLER_LOG_PATH=.wrangler
WRANGLER_LOG=debug

# Local E2E browser selection. Keep these overrides in .env, not this file.
# PLAYWRIGHT_BROWSER=webkit
# PLAYWRIGHT_BROWSER_PATH=/absolute/path/to/browser
