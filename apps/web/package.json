{
  "name": "web",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "imports": {
    "#shared/*": "./shared/*.ts",
    "#shared/utils/rule-modules": "./shared/utils/rule-modules.ts",
    "#shared/utils/rule-versions": "./shared/utils/rule-versions.ts"
  },
  "scripts": {
    "build": "bun run build:rules-wasm && nuxt build",
    "build:staging": "bun run build:rules-wasm && nuxt build --dotenv .env.staging",
    "build:production": "bun run build:rules-wasm && nuxt build --dotenv .env.production",
    "build:rules-wasm": "cd ../.. && cargo build --release --target wasm32-unknown-unknown && mkdir -p apps/web/worker/wasm && cp target/wasm32-unknown-unknown/release/fewfc.wasm apps/web/worker/wasm/fewfc.wasm",
    "cf:dev": "bun run build && bun db:migrate:local && bun run dev",
    "cf:deploy:staging": "wrangler deploy --env staging --keep-vars",
    "cf:deploy:production": "wrangler deploy --env production --keep-vars",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply fewfc-auth --local",
    "db:migrate:staging": "wrangler d1 migrations apply fewfc-auth-staging --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply fewfc-auth-production --remote --env production",
    "room:delete": "bun scripts/delete-room.ts",
    "purge:legacy-games": "bun scripts/purge-legacy-games.ts",
    "dev": "bun scripts/local-server.ts",
    "generate": "nuxt generate --dotenv .env.production",
    "preview": "nuxt preview --dotenv .env.production",
    "postinstall": "nuxt prepare",
    "test:unit": "bun test app shared worker scripts migrations",
    "test:e2e": "playwright test",
    "test:e2e:built": "FEWFC_E2E_PREBUILT=1 playwright test",
    "test:ticket22:multisession": "bun scripts/run-ticket22-multisession.ts",
    "test:e2e:server": "bun scripts/local-server.ts --e2e",
    "test:e2e:server:built": "bun scripts/local-server.ts --e2e --built",
    "typecheck": "nuxt typecheck",
    "validate:deploy": "bun validate-deploy-environment.ts",
    "test:component": "APP_ENV=development vitest --config vitest.config.ts --run",
    "test:component:browser": "playwright test --config playwright.component.config.ts",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "test:storybook": "bun scripts/test-storybook.ts",
    "test:storybook:layout": "playwright test --config playwright.storybook.config.ts",
    "test:integration": "bun test server",
    "test:worktree": "bun test ../../scripts/setup-worktree.test.ts",
    "dev:stop": "bun scripts/stop-servers.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.12",
    "better-auth": "1.7.12",
    "drizzle-orm": "^0.45.4",
    "h3": "^2.0.7",
    "nuxt": "^4.6.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-mcp": "^10.6.3",
    "@storybook/test-runner": "^0.26.0",
    "@storybook/vue3-vite": "10.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "^2.5.1",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^21.0.4",
    "miniflare": "5.20260908.0-alpha",
    "storybook": "^10.6.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13",
    "wrangler": "4.151.3"
  }
}
